# PharmOmics Agent environment configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Directory for local data files (expression matrices, metadata, etc.)
PHARMOMICS_DATA_DIR=

# Directory for analysis run outputs
PHARMOMICS_RUN_STORE_DIR=

# API key for LLM provider (required for AI-assisted reasoning features)
PHARMOMICS_LLM_API_KEY=
